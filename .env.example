# Local runtime only. No commercial API keys are used.
APP_NAME=AI Meeting Intelligence
DATA_DIR=data

# Speech-to-text. Use "small" on CPU, "large-v3" on an NVIDIA GPU.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_DOWNLOAD_ROOT=models/whisper

# Speaker diarization. Download Community-1 before going offline.
DIARIZATION_ENABLED=true
DIARIZATION_MODEL_PATH=models/pyannote-speaker-diarization-community-1

# Ollama runs on localhost. qwen3:8b is recommended for 16 GB RAM / 8 GB VRAM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=300

# Keep extraction deterministic and evidence-grounded.
LLM_TEMPERATURE=0
MAX_TRANSCRIPT_CHARS=90000

